<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- REPORTE PDF -->
    <template id="report_saleorder_document_no_taxes"
            inherit_id="sale.report_saleorder_document"
            priority="99">

        <xpath expr="//th[@name='th_taxes']" position="replace"/>
        <xpath expr="//td[contains(@name, 'tax')]" position="replace"/>

        <xpath expr="//td[@name='td_priceunit']" position="replace">
            <td name="td_priceunit" class="text-end text-nowrap">
                <t t-if="not line.display_type">
                    <t t-set="tax_computation"
                       t-value="line.tax_id.compute_all(
                           line.price_unit,
                           doc.currency_id,
                           1.0,
                           line.product_id,
                           doc.partner_shipping_id
                       )"/>
                    <span t-if="line.discount"
                          t-esc="tax_computation['total_included']"
                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'
                          style="text-decoration: line-through;" class="text-danger"/>
                    <t t-set="tax_computation_discounted"
                       t-value="line.tax_id.compute_all(
                           line.price_unit * (1 - line.discount / 100),
                           doc.currency_id,
                           1.0,
                           line.product_id,
                           doc.partner_shipping_id
                       )"/>
                    <span t-esc="tax_computation_discounted['total_included']"
                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                </t>
            </td>
        </xpath>

        <xpath expr="//td[@name='td_subtotal']" position="replace">
            <td name="td_subtotal" 
                t-attf-class="text-end {{ 'd-none d-sm-table-cell' if report_type == 'html' else '' }}">
                <t t-if="not line.display_type">
                    <t t-set="is_tax_included"
                       t-value="line.tax_id and all(t.price_include for t in line.tax_id)"/>
                    <t t-if="is_tax_included">
                        <span t-esc="line.price_unit * (1 - line.discount / 100) * line.product_uom_qty"
                            t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    </t>
                    <t t-else="">
                        <span t-field="line.price_total"
                            t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    </t>
                </t>
            </td>
        </xpath>

        <xpath expr="//div[@name='so_total_summary']" position="replace">
            <div class="clearfix" name="so_total_summary">
                <div id="total" class="row mt-n3" name="total">
                    <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                        <table class="o_total_table table table-borderless">
                            <t t-set="tax_totals_clean" t-value="dict(doc.tax_totals, subtotals=[])"/>
                            <t t-call="sale.document_tax_totals">
                                <t t-set="tax_totals" t-value="tax_totals_clean"/>
                                <t t-set="currency" t-value="doc.currency_id"/>
                            </t>
                        </table>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
    <!-- VISTA WEB (PORTAL) -->
    <template id="sale_order_portal_content_no_taxes"
              inherit_id="sale.sale_order_portal_content"
              priority="99">

        <xpath expr="//div[@id='introduction']" position="before">
            <style>
                #taxes_header { display: none !important; }
                #taxes,
                td[name='td_product_taxes'],
                td[name='td_combo_taxes'],
                td[name='td_section_group_taxes'] { display: none !important; }
            </style>
        </xpath>

        <xpath expr="//td[@id='quote_qty_td']/following-sibling::td[div[@t-field='line.price_unit']]"
               position="replace">
            <td t-attf-class="text-end {{ 'd-none d-sm-table-cell' if report_type == 'html' else '' }}">
                <t t-if="not line.is_downpayment
                         and not (line.display_type == 'line_section' or line.display_type == 'line_note')
                         and not line.combo_item_id">
                    <t t-set="tax_computation_original"
                       t-value="line.tax_id.compute_all(
                           line.price_unit,
                           sale_order.currency_id,
                           1.0,
                           line.product_id,
                           sale_order.partner_shipping_id
                       )"/>
                    <span t-if="line.discount"
                          t-esc="tax_computation_original['total_included']"
                          t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                          style="text-decoration: line-through;"
                          class="text-danger d-block"/>
                    <t t-set="tax_computation_discounted"
                       t-value="line.tax_id.compute_all(
                           line.price_unit * (1 - line.discount / 100),
                           sale_order.currency_id,
                           1.0,
                           line.product_id,
                           sale_order.partner_shipping_id
                       )"/>
                    <span t-esc="tax_computation_discounted['total_included']"
                          t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'/>
                </t>
                <t t-else="">
                    <div t-if="not (line.display_type == 'line_section' or line.display_type == 'line_note')"
                         t-field="line.price_unit"
                         class="text-end"/>
                </t>
            </td>
        </xpath>

        <xpath expr="//span[@t-field='line.price_subtotal']" position="replace">
            <t t-set="is_tax_included"
               t-value="line.tax_id and all(t.price_include for t in line.tax_id)"/>
            <t t-if="is_tax_included">
                <span t-esc="line.price_unit * (1 - line.discount / 100) * line.product_uom_qty"
                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'/>
            </t>
            <t t-else="">
                <span t-field="line.price_total"
                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'/>
            </t>
        </xpath>

        <xpath expr="//div[@id='total']" position="replace">
            <div id="total" class="row" name="total">
                <div t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                    <table class="table table-sm table-borderless">
                        <tr class="border-black o_total">
                            <td><strong>Total</strong></td>
                            <td class="text-end">
                                <span t-field="sale_order.amount_total"
                                      t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </xpath>
    </template>
</odoo>