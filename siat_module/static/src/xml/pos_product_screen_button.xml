<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="siat_module.PaymentScreenButtons"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]//button[hasclass('js_invoice')]" position="after">
            <button class="button btn btn-light py-3 text-start rounded-0 border-bottom"
                    t-att-class="{ 'highlight text-bg-primary': currentOrder.is_to_invoice_siat?.() }"
                    t-if="currentOrder.is_to_invoice?.()"
                    t-on-click="toggleIsToInvoiceSiat">
                <i class="fa fa-file-text me-2"/>Facturar SIAT
            </button>
        </xpath>
    </t>
</templates>