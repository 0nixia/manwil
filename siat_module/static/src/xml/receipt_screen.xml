<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="siat_module.ReceiptScreenCustom"
       t-inherit="point_of_sale.ReceiptScreen"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-options')]/div[hasclass('d-flex')][hasclass('gap-1')]" position="after">
            <div t-if="currentOrder.is_to_invoice_siat?.()">
                <button class="button btn btn-lg btn-primary w-100 py-3 mt-1"
                        t-on-click="printSiatTicket">
                    <i class="fa fa-print me-1"/> Imprimir Ticket SIAT
                </button>
            </div>
        </xpath>
    </t>
</templates>