<odoo>
    <record id="view_move_form_custom_button" model="ir.ui.view">
        <field name="name">account.move.form.custom.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_post']" position="after">
                <button name="action_post_siat"
                    string="Confirmar SIAT"
                    type="object"
                    class="btn-primary"
                    invisible="state != 'draft' or move_type != 'out_invoice'"/>
            </xpath>
        </field>
    </record>
    <record id="view_move_list_siat" model="ir.ui.view">
        <field name="name">account.move.invoice.list</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="siat_invoice_id"
                       string="Factura SIAT"
                       optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="view_out_invoice_list_inherit_siat" model="ir.ui.view">
        <field name="name">account.move.out.invoice.list.inherit.siat</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="siat_status" column_invisible="True"/>
                <field name="siat_real_invoice_number" 
                    string="Nro. Factura SIAT"
                    optional="show"/>
                <field name="siat_status_label" 
                    string="Estado SIAT"
                    widget="badge" 
                    decoration-success="siat_status == 'ISSUED'" 
                    decoration-danger="siat_status == 'VOID'" 
                    decoration-info="siat_status == 'REVERTED'"
                    decoration-warning="siat_status == 'ERROR'"
                    optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>