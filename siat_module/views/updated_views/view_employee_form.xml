<odoo>
  <record id="view_hr_employee_siat_form" model="ir.ui.view">
    <field name="name">hr.employee.form.inherit.siat</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="SIAT" name="siat_config">
          <group string="Puntos de Venta por Empresa">
            <field name="siat_pos_ids"
                  nolabel="1" 
                  colspan="2"
                  context="{'default_company_id': company_id}"
                  mode="list,form">
              <list editable="bottom" string="Puntos de Venta">
                <field name="company_id"/>
                <field name="puntoventa_id"
                      options="{'no_create': True, 'no_open': True}"
                      domain="[('company_id', '=', company_id), ('active', '=', True)]"/>
                <field name="actividad_id"
                      domain="[('company_id', '=', company_id)]"/>
              </list>
              <form string="Punto de Venta">
                <group>
                  <field name="company_id"/>
                  <field name="puntoventa_id"
                        options="{'no_create': True, 'no_open': True}"
                        domain="[('company_id', '=', company_id), ('active', '=', True)]"/>
                  <field name="actividad_id"
                        domain="[('company_id', '=', company_id)]"/>
                </group>
              </form>
            </field>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>