<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="siat_product_service_view_list" model="ir.ui.view">
    <field name="name">siat.product_service.view.list</field>
    <field name="model">siat.product_service</field>
    <field name="arch" type="xml">
      <list string="Producto Servicios" create="false" delete="false" duplicate="false">
        <field name="id"/>
        <field name="code"/>
        <field name="code_prod"/>
        <field name="desc_prod"/>
        <field name="write_date" string="Fecha Actualización"/>
      </list>
    </field>
  </record>
  <record id="siat_product_service_view_list_extra" model="ir.ui.view">
    <field name="name">siat.product_service.list.inherit</field>
    <field name="model">siat.product_service</field>
    <field name="inherit_id" ref="siat_module.siat_product_service_view_list"/>
    <field name="arch" type="xml">
        <xpath expr="//list" position="attributes">
            <attribute name="js_class">button_in_list_sync</attribute>
        </xpath>
    </field>
   </record>
</odoo>
