<odoo>
    <record id="invoice_cancellation_by_cuf_form" model="ir.ui.view">
        <field name="name">siat.invoice.cancellation.by.cuf.form</field>
        <field name="model">siat.invoice.cancellation.by.cuf</field>
        <field name="arch" type="xml">
            <form string="Cancelar Factura">
                <group>
                    <field name="cuf" string="CUF" type="char"/>
                    <field name="void_reason" string="Motivo Anulación"/>
                </group>
                <footer>
                    <button string="Confirmar" type="object" name="confirm_cancellation" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>