<odoo>
    <record id="invoice_cancellation_form" model="ir.ui.view">
        <field name="name">siat.invoice.cancelation.form</field>
        <field name="model">siat.invoice</field>
        <field name="arch" type="xml">
            <form string="Cancelar Factura">
                <group>
                    <field name="customer_name" string="Cliente" readonly='1'/>
                    <field name="invoice_number" string="Nro. Factura" readonly='1'/>
                    <field name="cuf" readonly='1'/>
                    <field name="invoice_datetime" string="Fecha Emisión" readonly='1'/>
                    <field name="void_reason" string="Motivo Anulación"/>
                </group>
                <footer>
                    <button string="Confirmar" type="object" name="confirm_cancellation" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
