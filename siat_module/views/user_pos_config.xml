<odoo>
    <record id="res_user_pos_form" model="ir.ui.view">
        <field name="name">res.users.pos.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="Configurar Punto de Venta">
                <group>
                    <field name="company_id" invisible="1"/>
                    <field name="company_ids" invisible="1"/>
                    <field name="puntoventa_id"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="actividad_id"/>
                </group>
                <footer>
                    <button string="Confirmar" type="object" name="store_pos" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
