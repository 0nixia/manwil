<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="siat_document_sector_view_list" model="ir.ui.view">
    <field name="name">siat.document_sector.view.list</field>
    <field name="model">siat.document_sector</field>
    <field name="arch" type="xml">
      <list string="Actividades Documento Sector" create="false" delete="false" duplicate="false">
        <field name="code_activity" />
        <field name="code_doc_sector"/>
        <field name="type_doc_sector"/>
        <field name="write_date" string="Fecha Actualización"/>
      </list>
    </field>
  </record>
  <record id="siat_document_sector_view_list_extra" model="ir.ui.view">
    <field name="name">siat.document_sector.list.inherit</field>
    <field name="model">siat.document_sector</field>
    <field name="inherit_id" ref="siat_module.siat_document_sector_view_list"/>
    <field name="arch" type="xml">
        <xpath expr="//list" position="attributes">
            <attribute name="js_class">button_in_list_sync</attribute>
        </xpath>
    </field>
   </record>
</odoo>
