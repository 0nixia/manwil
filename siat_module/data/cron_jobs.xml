<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="ir_cron_cron_siat_sync" model="ir.cron">
        <field name="name">Sincronizar catálogo SIAT</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">model.action_siat_sync_all()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"/>
    </record>

    <record id="ir_cron_cron_get_cufd" model="ir.cron">
        <field name="name">Obtener CUFD en POSs SIAT</field>
        <field name="model_id" ref="siat_module.model_siat_point_of_sale"/>
        <field name="state">code</field>
        <field name="code">model.get_all_pos_cufd()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 04:01:00')"/>
    </record>

    <record id="ir_cron_siat_reset_seq" model="ir.cron">
        <field name="name">Reiniciar numeración SIAT (inicio de gestión)</field>
        <field name="model_id" ref="base.model_ir_sequence"/>
        <field name="state">code</field>
        <field name="code">
sequences = model.search([('code', 'like', 'siat.invoice.%')])
sequences.write({'number_next': 1})
        </field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">12</field>
        <field name="interval_type">months</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now().replace(month=1, day=1) + timedelta(days=366)).strftime('%Y-01-01 00:05:00')"/>
    </record>
</odoo>