    <record id="rule_siat_emp_pos_manager" model="ir.rule">
        <field name="name">SIAT EmpPos: manager full access</field>
        <field name="model_id" ref="model_siat_employee_pos"/>
        <field name="groups" eval="[(4, ref('siat_module.group_siat_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_siat_emp_pos_own" model="ir.rule">
        <field name="name">SIAT EmpPos: user own record only</field>
        <field name="model_id" ref="model_siat_employee_pos"/>
        <field name="groups" eval="[(4, ref('siat_module.group_siat_user'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
